{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "noEmit": false,
        "declaration": false,
        "declarationMap": false,
        "allowImportingTsExtensions": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
